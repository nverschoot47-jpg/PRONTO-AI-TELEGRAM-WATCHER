bool wickSweep    = input.bool(false, "Reversal: a wick outside the box also counts (else prior close outside)", group = "Setup")
string candleDist = input.string("High-Low range", "Reversal SL: candle distance", options = ["High-Low range", "Body"], group = "Setup")

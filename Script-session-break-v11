string vwType     = input.string("Normal (chart daily)", "VWAP type", options = ["Normal (chart daily)", "Anchored: Brussels 00:00", "Anchored: each session open"], group = "VWAP")
string vwFilter   = input.string("Off", "Hard filter on signals", options = ["Off", "With trend", "Counter trend"], group = "VWAP")

bool sendWebhook  = input.bool(true, "Send alert() JSON on signals", group = "Webhook")
string brokerSym  = input.string("", "Broker symbol in JSON (blank = chart ticker)", group = "Webhook")

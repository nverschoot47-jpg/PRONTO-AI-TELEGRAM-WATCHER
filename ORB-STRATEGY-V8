// ── P&L-rapport: aggregaten per dag / week / maand ────────────────────────
type Agg
    array<int>   k      // periodesleutel (dag-index, maandag-index of jjjjmm)
    array<int>   n      // aantal trades
    array<int>   w      // winnaars (TP)
    array<int>   l      // verliezers (SL)
    array<int>   t      // timeouts (gesloten op tijd, ni winst ni SL)
    array<float> pnl    // netto € in die periode

newAgg() => Agg.new(array.new<int>(), array.new<int>(), array.new<int>(), array.new<int>(), array.new<int>(), array.new<float>())

var Agg aD = newAgg()
var Agg aW = newAgg()
var Agg aM = newAgg()

// kind: 1 = TP, 2 = SL, 3 = timeout. Trades sluiten chronologisch, dus alleen de laatste periode kan open staan.
addAgg(Agg a, int key, int kind, float val) =>
    int sz = a.k.size()
    if sz == 0 or a.k.last() != key
        a.k.push(key), a.n.push(0), a.w.push(0), a.l.push(0), a.t.push(0), a.pnl.push(0.0)
        sz += 1
    int j = sz - 1
    a.n.set(j, a.n.get(j) + 1)
    if kind == 1
        a.w.set(j, a.w.get(j) + 1)
    else if kind == 2
        a.l.set(j, a.l.get(j) + 1)
    else
        a.t.set(j, a.t.get(j) + 1)
    a.pnl.set(j, a.pnl.get(j) + val)
    sz


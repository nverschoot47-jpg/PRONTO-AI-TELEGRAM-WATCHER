fmtE(float v) =>
    int r = int(math.round(v))
    (r > 0 ? "+" : "") + str.tostring(r)

colE(float v) => v > 0 ? color.new(color.lime, 0) : v < 0 ? color.new(color.red, 0) : color.new(color.gray, 20)

fmtHit(int w, int l) => (w + l) > 0 ? str.tostring(int(math.round(w * 100.0 / (w + l)))) + "%" : "—"

putRow(table tb, int row, string lbl, int n, int w, int l, int t, float pnl) =>
    table.cell(tb, 0, row, lbl, text_color = color.white, text_size = size.tiny, text_halign = text.align_left)
    table.cell(tb, 1, row, str.tostring(n), text_color = color.white, text_size = size.tiny)
    table.cell(tb, 2, row, str.tostring(w), text_color = color.new(color.lime, 0), text_size = size.tiny)
    table.cell(tb, 3, row, str.tostring(l), text_color = color.new(color.red, 0), text_size = size.tiny)
    table.cell(tb, 4, row, str.tostring(t), text_color = color.new(color.gray, 20), text_size = size.tiny)
    table.cell(tb, 5, row, fmtHit(w, l), text_color = color.white, text_size = size.tiny)
    table.cell(tb, 6, row, fmtE(pnl), text_color = colE(pnl), text_size = size.tiny)
    table.cell(tb, 7, row, n > 0 ? fmtE(pnl / n) : "—", text_color = colE(pnl), text_size = size.tiny)
    0

putAgg(table tb, int row, string lbl, Agg a, int idx) =>
    if idx >= 0
        putRow(tb, row, lbl, a.n.get(idx), a.w.get(idx), a.l.get(idx), a.t.get(idx), a.pnl.get(idx))
    else
        putRow(tb, row, lbl, 0, 0, 0, 0, 0.0)
    0


                            array.set(cN, i, array.get(cN, i) + 1)

                            _l1 = toonLijn ? line.new(bar_index, _slP, bar_index + lijnBars, _slP,
                                 color = color.new(color.red, 10), width = 2) : na
                            _l2 = toonLijn ? line.new(bar_index, _tpP, bar_index + lijnBars, _tpP,
                                 color = color.new(color.green, 10), width = 2) : na
                            if toonLijn
                                label.new(bar_index + lijnBars, _slP, "SL " + str.tostring(math.round(_slP, dec)),
                                     style = label.style_none, textcolor = color.new(color.red, 15), size = size.tiny)
                                label.new(bar_index + lijnBars, _tpP, "TP " + str.tostring(math.round(_tpP, dec)),
                                     style = label.style_none, textcolor = color.new(color.green, 15), size = size.tiny)

                            _tip = "Slot " + str.tostring(i + 1) + (_lg ? "  BUY" : "  SELL") +
                                 "\nstart " + str.format("{0,number,00}:{1,number,00}",
                                      array.get(slH, i), array.get(slM, i)) +
                                 "   ORB " + str.tostring(array.get(slOrb, i)) + "m" +
                                 "   venster " + str.tostring(_win) + "m" +
                                 "\nentry " + str.tostring(math.round(close, dec)) +
                                 "\nSL " + str.tostring(math.round(_slP, dec)) +
                                 "  (×" + str.tostring(array.get(slMul, i), "#.#") + ")" +
                                 "\nTP " + str.tostring(math.round(_tpP, dec)) +
                                 "  (" + str.tostring(array.get(slRR, i), "#.#") + "R)" +
                                 "\nVWAP " + _vs
                            _lb = toonLbl ? label.new(bar_index, _lg ? low : high,
                                 labelVol ? "S" + str.tostring(i + 1) + (_lg ? " ▲ BUY" : " ▼ SELL") : "",
                                 style = labelVol ? (_lg ? label.style_label_up : label.style_label_down)
                                                  : (_lg ? label.style_triangleup : label.style_triangledown),
                                 color = _lg ? color.new(color.green, 10) : color.new(color.red, 10),
                                 textcolor = color.white, size = size.tiny, tooltip = _tip) : na

                            array.push(pos, Pos.new(close, _stp, _tpd, _lg ? 1 : 0, i,
                                 time + houdMin * 60000, _l1, _l2))

                            _id = sym + "-" +
                                 str.format("{0,number,00}{1,number,00}", array.get(slH, i), array.get(slM, i)) + "-" +
                                 str.tostring(array.get(slOrb, i)) + "m-x" +
                                 str.tostring(array.get(slMul, i), "#.#") + "-" +
                                 str.lower(_vs) + "-" + str.tostring(array.get(slRR, i), "#.#") + "R"

                            array.push(orders,
                                 '{"action":"'      + (_lg ? "buy" : "sell")                       + '"' +
                                  ',"symbol":"'     + sym                                          + '"' +
                                  ',"slot_id":"'    + _id                                          + '"' +
                                  ',"slot":'        + str.tostring(i + 1)                                +
                                  ',"trade_no":'    + str.tostring(tradeNr)                              +
                                  ',"entry":'       + str.tostring(math.round(close, dec))                +
                                  ',"sl":'          + str.tostring(math.round(_slP, dec))                 +
                                  ',"sl_points":'   + str.tostring(math.round(_stp, dec))                 +
                                  ',"tp":'          + str.tostring(math.round(_tpP, dec))                 +
                                  ',"tp_points":'   + str.tostring(math.round(_tpd, dec))                 +
                                  ',"rr":'          + str.tostring(array.get(slRR, i), "#.#")             +
                                  ',"sl_mult":'     + str.tostring(array.get(slMul, i), "#.#")            +
                                  ',"orb_start":"'  + str.format("{0,number,00}:{1,number,00}",
                                                         array.get(slH, i), array.get(slM, i))      + '"' +
                                  ',"orb_minutes":' + str.tostring(array.get(slOrb, i))                   +
                                  ',"venster_min":' + str.tostring(_win)                                  +
                                  ',"orb_high":'    + str.tostring(math.round(_hi, dec))                  +
                                  ',"orb_low":'     + str.tostring(math.round(_lo, dec))                  +
                                  ',"vwap_side":"'  + str.lower(_vs)                               + '"' +
                                  ',"vwap":'        + str.tostring(math.round(vw, dec))                   +
                                  ',"risk_pct":'    + str.tostring(riskPct, "#.##")                       +
                                  ',"expires_at":"' + str.format_time(time + houdMin * 60000,
                                                         "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC")         + '"' +
                                  '}')

if array.size(pos) > 0
    for i = array.size(pos) - 1 to 0
        p   = array.get(pos, i)
        fav = p.dir == 1 ? high - p.e : p.e - low
        adv = p.dir == 1 ? p.e - low  : high - p.e
        _sl = adv >= p.stop
        _tp = fav >= p.tp
        if _sl or _tp or time >= p.dl
            if _tp and not _sl
                array.set(cWin, p.slot, array.get(cWin, p.slot) + 1)
                if not na(p.lTP)
                    line.set_color(p.lTP, color.new(color.green, 0))

            // ── Rollend R bijwerken voor de monitor ───────────────────────
            if monAan
                _rGesloten = _sl ? -1.0 :
                     _tp ? p.tp / p.stop :
                     (p.dir == 1 ? (close - p.e) : (p.e - close)) / p.stop   // timeout: werkelijk R op sluitmoment
                _s   = p.slot
                _idx = array.get(rollPos, _s)
                _old = matrix.get(rollBuf, _s, _idx)
                _aft = array.get(rollSum, _s) + _rGesloten - (na(_old) ? 0.0 : _old)
                array.set(rollSum, _s, _aft)
                matrix.set(rollBuf, _s, _idx, _rGesloten)
                array.set(rollPos, _s, (_idx + 1) % rollN)
                _cnt = array.get(rollCnt, _s)
                if _cnt < rollN
                    array.set(rollCnt, _s, _cnt + 1)
                    _cnt := _cnt + 1
                _avg = _cnt > 0 ? _aft / _cnt : na
                array.set(slAvgR, _s, _avg)
                _base = array.get(slBaseEV, _s)
                _stat = _cnt < minTr ? 0 :
                     _avg < 0 ? 3 :
                     (not na(_base) and _avg < _base - warnMarg) ? 2 : 1
                array.set(slStat, _s, _stat)

            // ── P&L-rapport: SL = -verlies, TP = +verlies × RR, timeout = werkelijk R × verlies ──
            _kP  = _sl ? 2 : _tp ? 1 : 3
            _rP  = _sl ? -1.0 : _tp ? array.get(slRR, p.slot) :
                 (p.dir == 1 ? (close - p.e) : (p.e - close)) / p.stop
            _plP = _rP * verliesEur
            addAgg(aD, dIdx, _kP, _plP)
            addAgg(aW, wkKey, _kP, _plP)
            addAgg(aM, moKey, _kP, _plP)
            if array.get(wdLast, wdIdx) != dIdx
                array.set(wdLast, wdIdx, dIdx)
                array.set(wdDays, wdIdx, array.get(wdDays, wdIdx) + 1)
            array.set(wdN, wdIdx, array.get(wdN, wdIdx) + 1)
            array.set(wdW, wdIdx, array.get(wdW, wdIdx) + (_kP == 1 ? 1 : 0))
            array.set(wdL, wdIdx, array.get(wdL, wdIdx) + (_kP == 2 ? 1 : 0))
            array.set(wdT, wdIdx, array.get(wdT, wdIdx) + (_kP == 3 ? 1 : 0))
            array.set(wdP, wdIdx, array.get(wdP, wdIdx) + _plP)

            array.remove(pos, i)

if alertsAan and mag and array.size(orders) > 0
    alert('{"orders":[' + array.join(orders, ",") + ']}', alert.freq_once_per_bar_close)

var bool _flaggedAny = false

if barstate.islast and toonTab
    var table t = table.new(position.bottom_right, 12, N + 3, border_width = 1,
         frame_color = color.new(color.gray, 40), frame_width = 1)
    table.clear(t, 0, 0, 11, N + 2)
    hh = color.new(color.teal, 10)
    kk = array.from("slot", "start", "ORB", "venster", "SL×", "VWAP", "RR", "n", "TP", "WR", "live R", "status")
    for c = 0 to 11
        table.cell(t, c, 0, array.get(kk, c), text_color = color.white, bgcolor = hh, text_size = size.tiny)
    _r = 1
    _flaggedAny := false
    for i = 0 to N - 1
        _aan = array.get(slAct, i)
        if _aan or toonGeblok
            _tc = _aan ? color.white : color.new(color.gray, 55)
            _n  = array.get(cN, i)
            _w  = array.get(cWin, i)
            table.cell(t, 0, _r, "S" + str.tostring(i + 1) + (_aan ? "" : " ✕"), text_color = _tc, text_size = size.tiny)
            table.cell(t, 1, _r, str.format("{0,number,00}:{1,number,00}",
                 array.get(slH, i), array.get(slM, i)), text_color = _tc, text_size = size.tiny)
            table.cell(t, 2, _r, str.tostring(array.get(slOrb, i)) + "m", text_color = _tc, text_size = size.tiny)
            table.cell(t, 3, _r, str.tostring(array.get(slWin, i)) + "m", text_color = color.new(color.aqua, 0), text_size = size.tiny)
            table.cell(t, 4, _r, "×" + str.tostring(array.get(slMul, i), "#.#"), text_color = _tc, text_size = size.tiny)
            table.cell(t, 5, _r, array.get(slVw, i), text_color = _tc, text_size = size.tiny)
            table.cell(t, 6, _r, str.tostring(array.get(slRR, i), "#.#") + "R", text_color = _tc, text_size = size.tiny)
            table.cell(t, 7, _r, _aan ? str.tostring(_n) : "—", text_color = _tc, text_size = size.tiny)
            table.cell(t, 8, _r, _aan ? str.tostring(_w) : "—", text_color = _tc, text_size = size.tiny)
            table.cell(t, 9, _r, _aan and _n > 0 ? str.tostring(_w / _n * 100, "#") + "%" : "—",
                 text_color = _tc, text_size = size.tiny)

            // ── Monitorkolommen ────────────────────────────────────────────
            if _aan and monAan
                _avg  = array.get(slAvgR, i)
                _stat = array.get(slStat, i)
                table.cell(t, 10, _r, na(_avg) ? "…" : str.tostring(_avg, "#.##"),
                     text_color = _tc, text_size = size.tiny)
                _stTxt   = _stat == 0 ? "…" : _stat == 1 ? "OK" : _stat == 2 ? "zwak" : "LOSS"
                _stColor = _stat == 0 ? color.new(color.gray, 40) :
                     _stat == 1 ? color.new(color.green, 0) :
                     _stat == 2 ? color.new(color.orange, 0) : color.new(color.red, 0)
                table.cell(t, 11, _r, _stTxt, text_color = color.white, bgcolor = _stColor, text_size = size.tiny)
                if _stat >= 2
                    _flaggedAny := true
            else
                table.cell(t, 10, _r, "—", text_color = _tc, text_size = size.tiny)
                table.cell(t, 11, _r, "—", text_color = _tc, text_size = size.tiny)
            _r := _r + 1

    table.cell(t, 0, _r, syminfo.ticker, text_color = color.new(color.aqua, 0), text_size = size.tiny)
    table.cell(t, 1, _r, mag ? "preset " + effPreset : "GEEN PRESET",
         text_color = mag ? color.orange : color.red, text_size = size.tiny)
    table.cell(t, 3, _r, mag ? "" : "stil — symbool niet in de geverifieerde slots",
         text_color = color.red, text_size = size.tiny)

// ── P&L-rapport (tabellen) ──────────────────────────────────────────────────
if barstate.islast and pnlAan and mag
    var table tr = table.new(posOf(posRap), 8, rapRij + 12, border_width = 1,
         frame_color = color.new(color.gray, 40), frame_width = 1)
    var table tw = table.new(posOf(posWd), 9, 10, border_width = 1,
         frame_color = color.new(color.gray, 40), frame_width = 1)
    table.clear(tr, 0, 0, 7, rapRij + 11)
    table.clear(tw, 0, 0, 8, 9)
    hh2 = color.new(color.teal, 10)

    // Totalen over alle dagen
    _tn = 0
    _tw = 0
    _tl = 0
    _tt = 0
    _tp = 0.0
    for q = 0 to aD.k.size() - 1
        _tn += aD.n.get(q)
        _tw += aD.w.get(q)
        _tl += aD.l.get(q)
        _tt += aD.t.get(q)
        _tp += aD.pnl.get(q)
    _nD = aD.k.size(), _nW = aW.k.size(), _nM = aM.k.size()

    hk = array.from("periode", "trades", "W", "L", "TO", "hit%", "net €", "Ø/trade")
    for c = 0 to 7
        table.cell(tr, c, 0, array.get(hk, c), text_color = color.white, bgcolor = hh2, text_size = size.tiny)
    putAgg(tr, 1, "Vandaag", aD, lastIdx(aD, dIdx))
    putAgg(tr, 2, "Deze week", aW, lastIdx(aW, wkKey))
    putAgg(tr, 3, "Deze maand", aM, lastIdx(aM, moKey))
    putRow(tr, 4, "Totaal", _tn, _tw, _tl, _tt, _tp)

    // Gemiddelden en uitschieters (alleen periodes mét trades)
    table.cell(tr, 0, 5, "Ø per dag (" + str.tostring(_nD) + ")", text_color = color.white, text_size = size.tiny, text_halign = text.align_left)
    table.cell(tr, 0, 6, "Ø per week (" + str.tostring(_nW) + ")", text_color = color.white, text_size = size.tiny, text_halign = text.align_left)
    table.cell(tr, 0, 7, "Ø per maand (" + str.tostring(_nM) + ")", text_color = color.white, text_size = size.tiny, text_halign = text.align_left)
    table.cell(tr, 0, 8, "Beste dag", text_color = color.white, text_size = size.tiny, text_halign = text.align_left)
    table.cell(tr, 0, 9, "Slechtste dag", text_color = color.white, text_size = size.tiny, text_halign = text.align_left)
    _aDay = _nD > 0 ? _tp / _nD : 0.0
    _aWk  = _nW > 0 ? _tp / _nW : 0.0
    _aMo  = _nM > 0 ? _tp / _nM : 0.0
    table.cell(tr, 6, 5, fmtE(_aDay), text_color = colE(_aDay), text_size = size.tiny)
    table.cell(tr, 6, 6, fmtE(_aWk),  text_color = colE(_aWk),  text_size = size.tiny)
    table.cell(tr, 6, 7, fmtE(_aMo),  text_color = colE(_aMo),  text_size = size.tiny)
    if _nD > 0
        _mx = array.max(aD.pnl), _mn = array.min(aD.pnl)
        table.cell(tr, 1, 8, dagLbl(aD.k.get(array.indexof(aD.pnl, _mx))), text_color = color.white, text_size = size.tiny)
        table.cell(tr, 6, 8, fmtE(_mx), text_color = colE(_mx), text_size = size.tiny)
        table.cell(tr, 1, 9, dagLbl(aD.k.get(array.indexof(aD.pnl, _mn))), text_color = color.white, text_size = size.tiny)
        table.cell(tr, 6, 9, fmtE(_mn), text_color = colE(_mn), text_size = size.tiny)

    // Lijst van de laatste N periodes (nieuwste bovenaan)
    table.cell(tr, 0, 10, "Laatste " + str.tostring(rapRij) + " " + (rapPer == "Dag" ? "dagen" : rapPer == "Week" ? "weken" : "maanden"),
         text_color = color.new(color.aqua, 0), text_size = size.tiny, text_halign = text.align_left)
    Agg _lst = rapPer == "Dag" ? aD : rapPer == "Week" ? aW : aM
    for r = 0 to rapRij - 1
        _ix = _lst.k.size() - 1 - r
        if _ix >= 0
            _kk = _lst.k.get(_ix)
            _lb = rapPer == "Dag" ? dagLbl(_kk) : rapPer == "Week" ? wekLbl(_kk) : maaLbl(_kk)
            putAgg(tr, 11 + r, _lb, _lst, _ix)

    // Per weekdag
    wk2 = array.from("dag", "dagen", "trades", "W", "L", "hit%", "net €", "Ø/dag", "Ø/trade")
    for c = 0 to 8
        table.cell(tw, c, 0, array.get(wk2, c), text_color = color.white, bgcolor = hh2, text_size = size.tiny)
    wdNm = array.from("Maandag", "Dinsdag", "Woensdag", "Donderdag", "Vrijdag", "Zaterdag", "Zondag")
    _rw = 1
    for d = 0 to 6
        _nd = array.get(wdN, d)
        if d < 5 or _nd > 0
            _dg = array.get(wdDays, d), _pp = array.get(wdP, d)
            table.cell(tw, 0, _rw, array.get(wdNm, d), text_color = color.white, text_size = size.tiny, text_halign = text.align_left)
            table.cell(tw, 1, _rw, str.tostring(_dg), text_color = color.white, text_size = size.tiny)
            table.cell(tw, 2, _rw, str.tostring(_nd), text_color = color.white, text_size = size.tiny)
            table.cell(tw, 3, _rw, str.tostring(array.get(wdW, d)), text_color = color.new(color.lime, 0), text_size = size.tiny)
            table.cell(tw, 4, _rw, str.tostring(array.get(wdL, d)), text_color = color.new(color.red, 0), text_size = size.tiny)
            table.cell(tw, 5, _rw, fmtHit(array.get(wdW, d), array.get(wdL, d)), text_color = color.white, text_size = size.tiny)
            table.cell(tw, 6, _rw, fmtE(_pp), text_color = colE(_pp), text_size = size.tiny)
            table.cell(tw, 7, _rw, _dg > 0 ? fmtE(_pp / _dg) : "—", text_color = colE(_pp), text_size = size.tiny)
            table.cell(tw, 8, _rw, _nd > 0 ? fmtE(_pp / _nd) : "—", text_color = colE(_pp), text_size = size.tiny)
            _rw += 1
    _dgT = _nD
    table.cell(tw, 0, _rw, "Totaal", text_color = color.new(color.aqua, 0), text_size = size.tiny, text_halign = text.align_left)
    table.cell(tw, 1, _rw, str.tostring(_dgT), text_color = color.white, text_size = size.tiny)
    table.cell(tw, 2, _rw, str.tostring(_tn), text_color = color.white, text_size = size.tiny)
    table.cell(tw, 3, _rw, str.tostring(_tw), text_color = color.new(color.lime, 0), text_size = size.tiny)
    table.cell(tw, 4, _rw, str.tostring(_tl), text_color = color.new(color.red, 0), text_size = size.tiny)
    table.cell(tw, 5, _rw, fmtHit(_tw, _tl), text_color = color.white, text_size = size.tiny)
    table.cell(tw, 6, _rw, fmtE(_tp), text_color = colE(_tp), text_size = size.tiny)
    table.cell(tw, 7, _rw, _dgT > 0 ? fmtE(_tp / _dgT) : "—", text_color = colE(_tp), text_size = size.tiny)
    table.cell(tw, 8, _rw, _tn > 0 ? fmtE(_tp / _tn) : "—", text_color = colE(_tp), text_size = size.tiny)

// Losse, optionele alert — NIET hetzelfde kanaal als de order-webhook hierboven.
// Stel dit apart in via TradingView's "Alert instellen" als je een melding wilt
// zodra een slot naar "zwak" of "LOSS" kantelt.
alertcondition(monAan and _flaggedAny, title = "PRONTO ORB · degradatie",
     message = "Een of meer slots staan op zwak/LOSS in de monitor-tabel — controleer en overweeg een rescan.")

_vwKleur = close >= vw ? color.new(color.aqua, 0) : color.new(color.fuchsia, 0)
plot(toonVwap ? vw : na, "VWAP", color = _vwKleur, linewidth = 2)
